cff-version: 1.2.0
title: "HinEmo-9: An Emotion Dataset for Code-Mixed Hindi–English Across Two Scripts"
message: "If you use this dataset, please cite it as below."
type: dataset
authors:
  - family-names: Sahani
    given-names: Rakesh
    email: rakesh.sahani@rgu.ac.in
    affiliation: "Department of Computer Science & Engineering, Rajiv Gandhi University, Doimukh, India"
  - family-names: A
